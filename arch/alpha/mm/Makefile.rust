#
# Makefile for the linux alpha-specific parts of the memory manager.
#

obj-y	:= init.o fault.o tlbflush.o

# These objects have repository-owned Rust translations.  Keep the ordinary
# Kbuild object names and make the Rust sources the authoritative prerequisites;
# the shared Rust object rule supplies the kernel target, flags, depfiles and
# objtool integration.
$(obj)/init.o: $(src)/init.rs
$(obj)/fault.o: $(src)/fault.rs
$(obj)/tlbflush.o: $(src)/tlbflush.rs
