/* SPDX-License-Identifier: GPL-2.0 */
/*
 * Alpha EV6 entry point for the Rust implementation of the IPv6 pseudo-header
 * checksum.  Keep this assembly veneer because arch/alpha/lib/Makefile selects
 * this file by its established object name and callers require this symbol.
 */

	.globl csum_ipv6_magic
	.globl rust_csum_ipv6_magic
	.align 4
	.ent csum_ipv6_magic
	.frame $30,0,$26,0
csum_ipv6_magic:
	.prologue 0
	jsr	$26,rust_csum_ipv6_magic
	ret	$31,($26),1
	.end csum_ipv6_magic
	EXPORT_SYMBOL(csum_ipv6_magic)
