/* Exact typed WRITE_ONCE leaves, without native_set_p4d/pgd's policy. */
MM_VOID(write_pgd_once, (pgd_t *p, pgd_t v), WRITE_ONCE(*p, v))
MM_VOID(write_p4d_once, (p4d_t *p, p4d_t v), WRITE_ONCE(*p, v))
MM_VOID(write_pud_once, (pud_t *p, pud_t v), WRITE_ONCE(*p, v))
MM_VOID(write_pmd_once, (pmd_t *p, pmd_t v), WRITE_ONCE(*p, v))
MM_VOID(write_pte_once, (pte_t *p, pte_t v), WRITE_ONCE(*p, v))
/* Keep an independent native WARN_ON_ONCE record for each original site. */
MM_VOID(warn_pfn_pte_shadow_stack, (bool conflict), WARN_ON_ONCE(conflict))
MM_VOID(warn_set_p4d_safe, (bool conflict), WARN_ON_ONCE(conflict))
MM_VOID(warn_set_pud_safe, (bool conflict), WARN_ON_ONCE(conflict))
MM_VOID(warn_set_pmd_safe, (bool conflict), WARN_ON_ONCE(conflict))
MM_VOID(warn_set_pte_safe, (bool conflict), WARN_ON_ONCE(conflict))
MM_VOID(warn_pgd_populate_safe, (bool conflict), WARN_ON_ONCE(conflict))
MM_VOID(warn_p4d_populate_safe, (bool conflict), WARN_ON_ONCE(conflict))
MM_VOID(warn_pud_populate_safe, (bool conflict), WARN_ON_ONCE(conflict))
MM_VOID(warn_pmd_populate_kernel_safe, (bool conflict), WARN_ON_ONCE(conflict))
#ifdef CONFIG_PARAVIRT_XXL
/* Each of these is a single PVOP/alternative-patching site. In particular,
 * __set_pgd is the hook; set_pgd's L4/L5 branch is in Rust.
 */
MM_VOID(pv_set_pgd, (pgd_t *p, pgd_t v), __set_pgd(p, v))
MM_VOID(pv_set_p4d, (p4d_t *p, p4d_t v), set_p4d(p, v))
MM_VOID(pv_set_pud, (pud_t *p, pud_t v), set_pud(p, v))
MM_VOID(pv_set_pmd, (pmd_t *p, pmd_t v), set_pmd(p, v))
MM_VOID(pv_set_pte, (pte_t *p, pte_t v), set_pte(p, v))
MM_PRIMITIVE(pgdval_t, pv_pgd_val, (pgd_t v), pgd_val(v))
MM_PRIMITIVE(p4dval_t, pv_p4d_val, (p4d_t v), p4d_val(v))
MM_PRIMITIVE(pudval_t, pv_pud_val, (pud_t v), pud_val(v))
MM_PRIMITIVE(pmdval_t, pv_pmd_val, (pmd_t v), pmd_val(v))
MM_VOID(pv_alloc_p4d, (struct mm_struct *mm, unsigned long pfn), paravirt_alloc_p4d(mm, pfn))
MM_VOID(pv_alloc_pud, (struct mm_struct *mm, unsigned long pfn), paravirt_alloc_pud(mm, pfn))
MM_VOID(pv_alloc_pmd, (struct mm_struct *mm, unsigned long pfn), paravirt_alloc_pmd(mm, pfn))
MM_VOID(pv_alloc_pte, (struct mm_struct *mm, unsigned long pfn), paravirt_alloc_pte(mm, pfn))
#endif
#endif
