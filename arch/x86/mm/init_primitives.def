/* Each original logging callsite retains native printk/dynamic-debug metadata. */
MM_VOID(log_gbpages, (void), printk(KERN_INFO "Using GB pages for direct mapping\n"))
MM_VOID(log_disable_pcid, (void), pr_info("Incomplete global flushes, disabling PCID"))
MM_VOID(log_release_failed, (void), pr_warn("Failed to release memory for alloc_low_pages()"))
MM_VOID(log_unmapping_init, (unsigned long begin, unsigned long last), pr_info("debug: unmapping init [mem %#010lx-%#010lx]\n", begin, last))
MM_VOID(log_pagetable0, (p4d_t *a, p4d_t *b), printk(KERN_ERR "PAGETABLE BUG #00! %p <-> %p\n", a, b))
MM_VOID(log_pagetable1, (pud_t *a, pud_t *b), printk(KERN_ERR "PAGETABLE BUG #01! %p <-> %p\n", a, b))
MM_VOID(log_pagetable2, (pmd_t *a, pmd_t *b), printk(KERN_ERR "PAGETABLE BUG #02! %p <-> %p\n", a, b))
MM_VOID(log_pagetable3, (void), printk(KERN_ERR "PAGETABLE BUG #03!\n"))
MM_VOID(log_missing_fixmap, (void), printk(KERN_ERR "PGD FIXMAP MISSING, it should be setup in head.S!\n"))
MM_VOID(log_write_protect, (unsigned long k), printk(KERN_INFO "Write protecting the kernel read-only data: %luk\n", k))
#ifdef CONFIG_CPA_DEBUG
MM_VOID(log_cpa_undo, (unsigned long start, unsigned long end), printk(KERN_INFO "Testing CPA: undo %lx-%lx\n", start, end))
MM_VOID(log_cpa_again, (void), printk(KERN_INFO "Testing CPA: again\n"))
#endif
MM_VOID(log_memory_block_size, (unsigned long size), pr_info("x86/mm: Memory block size: %ldMB\n", size))
MM_INIT_VOID(init_trampoline_kaslr, (void), init_trampoline_kaslr())
MM_INIT_VOID(early_memtest, (phys_addr_t start, phys_addr_t end), early_memtest(start, end))
