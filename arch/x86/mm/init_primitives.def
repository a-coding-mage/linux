/* Native header/compiler boundary. Remaining header algorithms are tracked
 * separately; the H2 page-table decisions live in init_pgtable.rs.
 * No init.c/init_64.c bodies.
 */
MM_PRIMITIVE(unsigned long, __pa, (const void *p), __pa(p))
MM_PRIMITIVE(void *, __va, (unsigned long p), __va(p))
MM_PRIMITIVE(unsigned long, pa_symbol, (const void *p), __pa_symbol(p))
MM_PRIMITIVE(unsigned int, get_order, (unsigned long n), get_order(n))
MM_PRIMITIVE(unsigned long, alloc_low_after_bootmem, (unsigned int order), __get_free_pages(GFP_ATOMIC | __GFP_ZERO, order))
MM_VOID(clear_page, (void *p), clear_page(p))
MM_PRIMITIVE(bool, debug_pagealloc_enabled, (void), debug_pagealloc_enabled())
MM_VOID(cr4_set_bits, (unsigned long mask), cr4_set_bits(mask))
MM_PRIMITIVE(bool, boot_has_pse, (void), boot_cpu_has(X86_FEATURE_PSE))
MM_PRIMITIVE(bool, boot_has_pge, (void), boot_cpu_has(X86_FEATURE_PGE))
MM_PRIMITIVE(bool, boot_has_gbpages, (void), boot_cpu_has(X86_FEATURE_GBPAGES))
MM_PRIMITIVE(bool, boot_has_pcid, (void), boot_cpu_has(X86_FEATURE_PCID))
