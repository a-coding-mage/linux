MM_PRIMITIVE(bool, feature_pse, (void), cpu_feature_enabled(X86_FEATURE_PSE))
MM_PRIMITIVE(bool, feature_hypervisor, (void), cpu_feature_enabled(X86_FEATURE_HYPERVISOR))
