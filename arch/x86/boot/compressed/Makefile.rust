# SPDX-License-Identifier: GPL-2.0
# Let c_flags emit Clang dependencies with the input header first.
# Bindgen depfiles sort includes, violating native fixdep's source contract.
# The ordinary %.rs rule injects kernel/alloc/metadata and the kernel code model.
# These rules deliberately use an isolated, freestanding early-boot sysroot.
boot-rust-lib-src := $(if $(RUST_LIB_SRC),$(RUST_LIB_SRC),$(shell $(RUSTC) --print sysroot)/lib/rustlib/src/rust/library)
boot-rust-target := $(obj)/boot-target.json
boot-rust-flags := $(rust_common_flags) \
	--target=$(boot-rust-target) --sysroot=/dev/null \
	-Cpanic=abort -Cembed-bitcode=y -Clto=n -Ccodegen-units=1 \
	-Cforce-unwind-tables=n -Csymbol-mangling-version=v0 \
	-Copt-level=2 -Ccode-model=small -Crelocation-model=pie -Cno-redzone=y \
	-Ctarget-feature=-sse,-sse2,-sse3,-ssse3,-sse4.1,-sse4.2,-avx,-avx2 \
	-Zfunction-sections=y -Zno-jump-tables \
	-Zdefault-visibility=hidden -Zdirect-access-external-data=y \
	-Zrelax-elf-relocations=n -Zplt=y \
	-Cdebug-assertions=$(if $(CONFIG_RUST_DEBUG_ASSERTIONS),y,n) \
	-Coverflow-checks=$(if $(CONFIG_RUST_OVERFLOW_CHECKS),y,n) \
	$(if $(CONFIG_WERROR),-Dwarnings) $(KRUSTFLAGS)
boot-rust-cfg := @$(objtree)/include/generated/rustc_cfg --cfg lupos_boot --cfg PREBOOT
boot-rust-deps := $(src)/boot_bindings.rs $(src)/cmdline.rs $(src)/error.rs \
	$(if $(CONFIG_ACPI),$(src)/acpi.rs $(src)/boot_acpi_bindings.rs) \
	$(src)/boot_efi_bindings.rs $(if $(CONFIG_EFI),$(src)/efi.rs) \
	$(src)/boot_cpu_bindings.rs $(src)/cpuflags.rs $(src)/../cpuflags.rs \
	$(if $(CONFIG_EARLY_PRINTK),$(src)/early_serial_console.rs $(src)/../early_serial_console.rs) \
	$(if $(CONFIG_X86_64),$(src)/boot_idt_bindings.rs $(src)/idt_64.rs) \
	$(if $(CONFIG_X86_64),$(src)/boot_pgtable_bindings.rs $(src)/pgtable_64.rs) \
	$(if $(CONFIG_X86_64),$(src)/boot_ident_map_bindings.rs $(src)/ident_map_64.rs $(src)/../../mm/ident_map.rs) \
	$(src)/misc.rs $(src)/string.rs $(src)/../string.rs $(if $(CONFIG_RANDOMIZE_BASE),$(src)/kaslr.rs) \
	$(srctree)/lib/ctype.rs $(srctree)/include/linux/ctype_header.rs \
	$(srctree)/lib/cmdline.rs $(srctree)/lib/decompress_inflate.rs \
	$(addprefix $(srctree)/lib/zlib_inflate/,inflate.rs inftrees.rs inffast.rs infutil.rs inffixed_header.rs)

targets += boot-target.json boot.o boot.a libcore.rlib libcompiler_builtins.rlib \
	boot_bindings_generated.rs boot_build.rs boot_helpers.o
targets += boot_cpu_bindings_generated.rs
targets += boot_idt_bindings_generated.rs
targets += boot_pgtable_bindings_generated.rs
targets += boot_ident_map_bindings_generated.rs
targets += boot_efi_bindings_generated.rs
targets += boot_acpi_bindings_generated.rs

quiet_cmd_boot_core = RUSTC BOOT $@
      cmd_boot_core = $(RUSTC) $(filter-out --edition=2021 -Wunreachable_pub,$(boot-rust-flags)) \
	--edition=$(if $(call rustc-min-version,108700),2024,2021) --cfg no_fp_fmt_parse \
	--crate-name core --crate-type rlib --emit=link=$@,dep-info=$(depfile) $<
$(obj)/libcore.rlib: $(boot-rust-lib-src)/core/src/lib.rs $(boot-rust-target) FORCE
	$(call if_changed_dep,boot_core)

quiet_cmd_boot_builtins = RUSTC BOOT $@
# This empty no_builtins marker is excluded from rustc's LTO. Its embedded
# bitcode would survive the partial link as non-alloc .llvmbc/.llvmcmd sections.
# Keep core's bitcode and the compressed crate's fat LTO unchanged.
      cmd_boot_builtins = $(RUSTC) $(filter-out -Cembed-bitcode=%,$(boot-rust-flags)) \
	-Cembed-bitcode=n --crate-name compiler_builtins \
	--crate-type rlib --extern core=$(obj)/libcore.rlib --emit=link=$@,dep-info=$(depfile) $<
$(obj)/libcompiler_builtins.rlib: $(src)/boot_compiler_builtins.rs $(obj)/libcore.rlib FORCE
	$(call if_changed_dep,boot_builtins)

quiet_cmd_boot_bindgen = BINDGEN BOOT $@
      cmd_boot_bindgen = $(BINDGEN) $< --rust-target 1.85 --use-core \
	--ctypes-prefix core::ffi --no-layout-tests --wrap-unsafe-ops --no-debug '.*' \
	--no-prepend-enum-name --with-derive-default \
	--blocklist-type '__kernel_(size_t|ssize_t|ptrdiff_t)' \
	--allowlist-type '(boot_params|setup_header|screen_info|port_io_ops|mem_vector|boot_e820_entry|setup_data|setup_indirect|efi_memory_desc_t|kho_data|kho_scratch|Elf32_Ehdr|Elf32_Phdr|Elf64_Ehdr|Elf64_Phdr|boot_memptr|acpi_physical_address|phys_addr_t|z_stream|z_stream_s|z_streamp|inflate_state|inflate_workspace|inflate_mode|code|codetype)' \
	--allowlist-function '(get_cmd_line_ptr|cmdline_find_option.*|__putstr|__puthex|__putdec|warn|error|malloc|free|memcpy|memmove|memset|strcmp|strncmp|strchr|strlen|strnlen|strstr|simple_strto.*|skip_spaces|boot_kstrtoul|has_cpuflag|count_immovable_mem_regions|__efi_soft_reserve_enabled)' \
	--allowlist-var '(LUPOS_BOOT_.*|CONFIG_PHYSICAL_ALIGN|COMMAND_LINE_SIZE|RDRAND_RETRY_LOOPS|X86_FEATURE_RDRAND|X86_FEATURE_TSC|EINVAL|ENOMEM|SETUP_.*|EFI_.*|EFI32_LOADER_SIGNATURE|EFI64_LOADER_SIGNATURE|E820_TYPE_RAM|EI_MAG.*|ELFMAG.*|PT_LOAD|KASLR_FLAG|XLF_MEM_ENCRYPTION|Z_.*|MAX_WBITS|ENOUGH|MAXD|boot_params_ptr|pio_ops|immovable_mem|__pgtable_l5_enabled)' \
	-o $@ -- $(c_flags) -fno-builtin -D__BINDGEN__
$(obj)/boot_bindings_generated.rs: $(src)/boot_maxmem_bindings.h $(src)/boot_bindings.h $(obj)/../voffset.h FORCE
	$(call if_changed_dep,boot_bindgen)

# Firmware layouts and C declarations only. Keep the aligned EFI GUID typedef
# and boot_params identity shared with the Rust EFI owner and its ACPI caller.
quiet_cmd_boot_efi_bindgen = BINDGEN BOOT EFI $@
      cmd_boot_efi_bindgen = $(BINDGEN) $< --rust-target 1.85 --use-core \
	--ctypes-prefix core::ffi --no-layout-tests --wrap-unsafe-ops --no-debug '.*' \
	--no-prepend-enum-name --with-derive-default \
	--blocklist-type '(boot_params|efi_guid_t)' \
	--allowlist-type '(efi_type|efi_setup_data|efi_config_table_64_t|efi_config_table_32_t|efi_system_table_64_t|efi_system_table_32_t)' \
	--allowlist-function '(efi_get_type|efi_get_system_table|efi_get_conf_table|efi_find_vendor_table)' \
	--allowlist-var '(EFI_TYPE_.*|LUPOS_BOOT_EFI_.*)' \
	-o $@ -- $(c_flags) -fno-builtin -D__BINDGEN__
$(obj)/boot_efi_bindings_generated.rs: $(src)/boot_efi_bindings.h FORCE
	$(call if_changed_dep,boot_efi_bindgen)

# The setup/decompressor CPUID ABI conflicts by name with the kernel's API.
# Generate from its own native header, without importing broad kernel headers.
quiet_cmd_boot_cpu_bindgen = BINDGEN BOOT CPU $@
      cmd_boot_cpu_bindgen = $(BINDGEN) $< --rust-target 1.85 --use-core \
	--ctypes-prefix core::ffi --no-layout-tests --wrap-unsafe-ops --no-debug '.*' \
	--no-prepend-enum-name --with-derive-default \
	--allowlist-type 'cpu_features' \
	--allowlist-function '(get_cpuflags|cpuid_count|has_cpuflag|has_eflag)' \
	--allowlist-var '(cpu|cpu_vendor|NCAPINTS|X86_FEATURE_FPU|LUPOS_BOOT_X86_.*)' \
	-o $@ -- $(c_flags) -fno-builtin -D__BINDGEN__
$(obj)/boot_cpu_bindings_generated.rs: $(src)/boot_cpu_bindings.h FORCE
	$(call if_changed_dep,boot_cpu_bindgen)

# Packed descriptor layouts and bitfields come from the native x86 headers.
quiet_cmd_boot_idt_bindgen = BINDGEN BOOT IDT $@
      cmd_boot_idt_bindgen = $(BINDGEN) $< --rust-target 1.85 --use-core \
	--ctypes-prefix core::ffi --no-layout-tests --wrap-unsafe-ops --no-debug '.*' \
	--no-prepend-enum-name --with-derive-default \
	--allowlist-type '(gate_desc|desc_ptr)' \
	--allowlist-function '(boot_page_fault|boot_nmi_trap|boot_stage1_vc|boot_stage2_vc|sev_es_shutdown_ghcb)' \
	--allowlist-var '(boot_idt|boot_idt_desc|sev_status|BOOT_IDT_ENTRIES|GATE_TRAP|X86_TRAP_PF|X86_TRAP_NMI|X86_TRAP_VC|LUPOS_BOOT_IDT_.*)' \
	-o $@ -- $(c_flags) -fno-builtin -D__BINDGEN__
$(obj)/boot_idt_bindings_generated.rs: $(src)/boot_idt_bindings.h FORCE
	$(call if_changed_dep,boot_idt_bindgen)

# Native page-table layout, assembly declarations and macro values only.
quiet_cmd_boot_pgtable_bindgen = BINDGEN BOOT PGTABLE $@
      cmd_boot_pgtable_bindgen = $(BINDGEN) $< --rust-target 1.85 --use-core \
	--ctypes-prefix core::ffi --no-layout-tests --wrap-unsafe-ops --no-debug '.*' \
	--no-prepend-enum-name --with-derive-default \
	--allowlist-type 'pgd_t' \
	--allowlist-function 'trampoline_32bit_src' \
	--allowlist-var '(trampoline_ljmp_imm_offset|physical_mask|sme_me_mask|LUPOS_BOOT_PGTABLE_.*)' \
	-o $@ -- $(c_flags) -fno-builtin -D__BINDGEN__
$(obj)/boot_pgtable_bindings_generated.rs: $(src)/boot_pgtable_bindings.h FORCE
	$(call if_changed_dep,boot_pgtable_bindgen)

# Layout/constant boundary only; mapping and privileged instructions are Rust.
quiet_cmd_boot_ident_map_bindgen = BINDGEN BOOT IDENT MAP $@
      cmd_boot_ident_map_bindgen = $(BINDGEN) $< --rust-target 1.85 --use-core \
	--ctypes-prefix core::ffi --no-layout-tests --wrap-unsafe-ops --no-debug '.*' \
	--no-prepend-enum-name --with-derive-default \
	--allowlist-type '(x86_pf_error_code|x86_mapping_info|pgd_t|p4d_t|pud_t|pmd_t|pte_t|pt_regs|phys_addr_t)' \
	--allowlist-function '(sev_prep_identity_maps|snp_check_features|sev_es_check_ghcb_fault|snp_set_page_shared|snp_set_page_private)' \
	--allowlist-var '(LUPOS_IDENT_.*|X86_PF_PROT|X86_PF_USER|X86_PF_RSVD|__pgtable_l5_enabled|pgdir_shift|ptrs_per_p4d|sme_me_mask|spurious_nmi_count|_pgtable|_head|_end)' \
	-o $@ -- $(c_flags) -fno-builtin -D__BINDGEN__
$(obj)/boot_ident_map_bindings_generated.rs: $(src)/boot_ident_map_bindings.h FORCE
	$(call if_changed_dep,boot_ident_map_bindgen)

# Native packed tables and configured constants only; ACPI bodies are Rust.
quiet_cmd_boot_acpi_bindgen = BINDGEN BOOT ACPI $@
      cmd_boot_acpi_bindgen = $(BINDGEN) $< --rust-target 1.85 --use-core \
	--ctypes-prefix core::ffi --no-layout-tests --wrap-unsafe-ops --no-debug '.*' \
	--no-prepend-enum-name --with-derive-default \
	--allowlist-type '(acpi_table_rsdp|acpi_table_header|acpi_table_srat|acpi_subtable_header|acpi_srat_mem_affinity|acpi_srat_type)' \
	--allowlist-var '(LUPOS_BOOT_ACPI_.*|ACPI_SIG_RSDP|ACPI_SIG_SRAT|ACPI_RSDP_.*|ACPI_EBDA_PTR_LOCATION|ACPI_EBDA_WINDOW_SIZE|ACPI_HI_RSDP_WINDOW_BASE|ACPI_HI_RSDP_WINDOW_SIZE|ACPI_SRAT_TYPE_MEMORY_AFFINITY|ACPI_SRAT_MEM_HOT_PLUGGABLE)' \
	-o $@ -- $(c_flags) -fno-builtin -D__BINDGEN__
$(obj)/boot_acpi_bindings_generated.rs: $(src)/boot_acpi_bindings.h FORCE
	$(call if_changed_dep,boot_acpi_bindgen)

# Preserve the C source's exact concatenated build entropy including its NUL.
$(obj)/boot_build.rs: $(src)/boot_build.rs.S FORCE
	$(call if_changed_dep,rustc_rs_rs_S)

quiet_cmd_boot_rust = RUSTC BOOT $@
      cmd_boot_rust = LUPOS_BOOT_OBJ=$(abspath $(obj)) \
	$(RUSTC) $(filter-out -Clto=n,$(boot-rust-flags)) -Clto=fat $(boot-rust-cfg) \
	--crate-name compressed_boot --crate-type staticlib -Ldependency=$(obj) \
	--extern core=$(obj)/libcore.rlib \
	--extern compiler_builtins=$(obj)/libcompiler_builtins.rlib \
	--emit=link=$@,dep-info=$(depfile) $<
$(obj)/boot.a: $(src)/boot.rs $(boot-rust-deps) $(obj)/boot_bindings_generated.rs \
	$(obj)/boot_efi_bindings_generated.rs \
	$(obj)/boot_cpu_bindings_generated.rs $(if $(CONFIG_X86_64),$(obj)/boot_idt_bindings_generated.rs) \
	$(if $(CONFIG_X86_64),$(obj)/boot_pgtable_bindings_generated.rs) \
	$(if $(CONFIG_X86_64),$(obj)/boot_ident_map_bindings_generated.rs) \
	$(if $(CONFIG_ACPI),$(obj)/boot_acpi_bindings_generated.rs) \
	$(obj)/boot_build.rs $(obj)/libcompiler_builtins.rlib FORCE
	$(call if_changed_dep,boot_rust)

# Whole-program optimization sees the genuine panic handler ignores PanicInfo.
# It removes only unused format/location metadata, preserving checked branches
# and the original Rust error/hlt path. Non-LTO core creates forbidden absolute
# pointers; the relocation gate above the final boot link rejects regression.
#
# Private section collection prevents unused core routines from entering the
# decompressor. These are all C/assembly-visible roots of the replaced units.
boot-rust-roots := extract_kernel decompress_kernel kernel_text_size kernel_inittext_size kernel_inittext_offset \
	$(if $(CONFIG_EFI),efi_get_type efi_get_system_table efi_get_conf_table efi_find_vendor_table) \
	kernel_total_size memcmp bcmp strcmp strncmp strnlen simple_strtoull simple_strtol strlen strstr strchr boot_kstrtoul memcpy memmove memset boot_params_ptr pio_ops free_mem_ptr free_mem_end_ptr \
	spurious_nmi_count malloc free __putstr __puthex __putdec warn error \
	get_cmd_line_ptr cmdline_find_option cmdline_find_option_bool \
	get_cpuflags cpuid_count has_cpuflag cpu cpu_vendor $(if $(CONFIG_X86_32),has_eflag) \
	$(if $(CONFIG_EARLY_PRINTK),console_init early_serial_base) \
	$(if $(CONFIG_X86_64),load_stage1_idt load_stage2_idt cleanup_exception_handling) \
	$(if $(CONFIG_X86_64),configure_5level_paging __pgtable_l5_enabled pgdir_shift ptrs_per_p4d trampoline_32bit) \
	$(if $(CONFIG_X86_64),initialize_identity_maps kernel_add_identity_map kernel_ident_mapping_init kernel_ident_mapping_free set_page_decrypted set_page_encrypted set_page_non_present do_boot_page_fault do_boot_nmi_trap __default_kernel_pte_mask physical_mask) \
	$(if $(CONFIG_ACPI),get_rsdp_addr immovable_mem $(if $(and $(CONFIG_RANDOMIZE_BASE),$(CONFIG_MEMORY_HOTREMOVE)),count_immovable_mem_regions)) \
	__cmdline_find_option __cmdline_find_option_bool \
	inflate_fast zlib_inflate zlib_inflateEnd zlib_inflateIncomp \
	zlib_inflateInit2 zlib_inflateReset zlib_inflate_table zlib_inflate_workspacesize \
	$(if $(CONFIG_RANDOMIZE_BASE),choose_random_location kaslr_get_random_long _ctype get_option get_options memparse next_arg parse_option_str skip_spaces) \
	$(if $(CONFIG_EFI_STUB),panic)
quiet_cmd_boot_rust_link = LD BOOT $@
      cmd_boot_rust_link = $(LD) -r --gc-sections \
	$(addprefix --undefined=,$(boot-rust-roots)) -o $@ \
	--whole-archive $(obj)/boot.a --no-whole-archive && \
	$(CONFIG_SHELL) $(src)/verify-rust-boot.sh $(READELF) $@
$(obj)/boot.o: $(obj)/boot.a $(src)/verify-rust-boot.sh FORCE
	$(call if_changed,boot_rust_link)

# Start from this compiler's supported freestanding ABI. Unlike the kernel
# target, compressed boot uses small addressing and no stack-clash probes.
quiet_cmd_boot_target = TARGET BOOT $@
      cmd_boot_target = $(CONFIG_SHELL) $(src)/generate-rust-target.sh $@ $(RUSTC)
$(boot-rust-target): $(src)/Makefile.rust $(src)/generate-rust-target.sh $(wildcard $(RUSTC)) FORCE
	$(call if_changed,boot_target)

# Compiler/bindgen replacement at the same configured path also invalidates it.
$(obj)/libcore.rlib $(obj)/libcompiler_builtins.rlib $(obj)/boot.a: $(wildcard $(RUSTC))
$(obj)/boot_bindings_generated.rs $(obj)/boot_cpu_bindings_generated.rs $(obj)/boot_idt_bindings_generated.rs: $(wildcard $(BINDGEN))
$(obj)/boot_pgtable_bindings_generated.rs: $(wildcard $(BINDGEN))
$(obj)/boot_ident_map_bindings_generated.rs: $(wildcard $(BINDGEN))
$(obj)/boot_efi_bindings_generated.rs: $(wildcard $(BINDGEN))
$(obj)/boot_acpi_bindings_generated.rs: $(wildcard $(BINDGEN))

# Preserve the original C helper's standalone reference-build dependency.
# It is not linked into the selected Rust compressed kernel.
$(obj)/boot_helpers.o: $(obj)/../voffset.h
# Version stamps cover PATH-resolved tools as well as explicit executable paths.
$(boot-rust-target) $(obj)/libcore.rlib: $(wildcard $(objtree)/include/config/RUSTC_VERSION_TEXT)
$(obj)/boot_bindings_generated.rs $(obj)/boot_cpu_bindings_generated.rs $(obj)/boot_idt_bindings_generated.rs: $(wildcard $(objtree)/include/config/BINDGEN_VERSION_TEXT)
$(obj)/boot_pgtable_bindings_generated.rs: $(wildcard $(objtree)/include/config/BINDGEN_VERSION_TEXT)
$(obj)/boot_ident_map_bindings_generated.rs: $(wildcard $(objtree)/include/config/BINDGEN_VERSION_TEXT)
$(obj)/boot_efi_bindings_generated.rs: $(wildcard $(objtree)/include/config/BINDGEN_VERSION_TEXT)
$(obj)/boot_acpi_bindings_generated.rs: $(wildcard $(objtree)/include/config/BINDGEN_VERSION_TEXT)
