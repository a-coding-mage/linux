# Canonical owner     reviewed effective C strategy     explicit C exemptions
# Optional native-zero records an original strong-policy object with no
# guarded emitted body. It does not exempt any function from strong policy.
# Enrollment requires original native flags/function-annotation review.
# Exemptions name emitted symbols, never whole-file wildcard matches.
# init/main.c explicitly marks start_kernel __no_stack_protector because it
# initializes the guard itself. The other five original files have no exemption.
init/main                 strong start_kernel
init/initramfs            strong -
kernel/fork               strong -
kernel/exit               strong -
kernel/panic              strong -
arch/x86/kernel/setup     strong -
# The following original C owners have no explicit SSP exemptions.
mm/memblock               strong -
arch/x86/mm/init          strong -
# Actual configured original init_64.o: zero guard and failure relocations.
arch/x86/mm/init_64       strong - native-zero
kernel/kthread            strong -
# handle.c's conditional noinstr is not an SSP exemption in compiler_types.h.
kernel/irq/irqdesc        strong -
kernel/irq/handle         strong -
kernel/irq/chip           strong -
# Original allocator and scheduler owners use strong protection, without SSP exemptions.
mm/page_alloc             strong -
mm/mmap                   strong -
mm/vmalloc                strong -
kernel/sched/idle         strong -
kernel/sched/clock        strong -

mm/memory                 strong -
mm/userfaultfd            strong -
mm/mremap                 strong -
mm/mprotect               strong -

mm/rmap                   strong -

mm/vmscan                 strong -

mm/slub                   strong -

mm/slab_common            strong -

mm/compaction             strong -

mm/migrate                strong -

mm/vmstat                 strong -
