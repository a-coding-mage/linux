# SPDX-License-Identifier: GPL-2.0-only
# ===========================================================================
# Module final link
# ===========================================================================

PHONY := __modfinal
__modfinal:

include $(objtree)/include/config/auto.conf
include $(srctree)/scripts/Kbuild.include
include $(srctree)/scripts/Makefile.lib

# find all modules listed in modules.order
modules := $(call read-file, modules.order)

__modfinal: $(modules:%.o=%.ko)
	@:

# modname and part-of-module are set to make c_flags define proper module flags
modname = $(notdir $(patsubst %.mod.rs,%,$(@:.mod.o=)))
part-of-module = y
GCOV_PROFILE := n
ccflags-remove-y := $(CC_FLAGS_CFI)
# These two metadata-only translation units run after modpost. Header-only
# KCFI references must not introduce new imports without symbol versions here.
# Generated KSYMTAB/SYMBOL_CRC records do not use EXPORT_SYMBOL and are retained.
ccflags-y += -D__DISABLE_EXPORTS

ifneq ($(filter y,$(CONFIG_RUST_MODULE_METADATA) $(CONFIG_RUST_MODULE_COMMON)),)
rustflags-remove-y += $(RUSTC_FLAGS_CFI)
endif

ifeq ($(CONFIG_RUST_MODULE_METADATA),y)
# This translation unit describes already-versioned owners. Do not use the
# owner rule: it runs gen_symversions and may inject C helper bitcode.
module-metadata-asm-feature := $(if $(CONFIG_PPC),asm_experimental_arch)

quiet_cmd_module_metadata_data = MODDATA $@
      cmd_module_metadata_data = \
	$(CC) $(c_flags) -fmacro-prefix-map=$<=$(patsubst %.h,%.c,$<) -fsyntax-only -x c $<; \
	mv $(depfile) $(depfile).validate; \
	$(CC) $(c_flags) -fmacro-prefix-map=$<=$(patsubst %.h,%.c,$<) \
		-DLUPOS_RUST_MODULE_RECORDS -E -P -x c $< > $@.input; \
	cat $(depfile).validate >> $(depfile); \
	$(objtree)/scripts/mod/modpost-rust --rust-module-records < $@.input > $@.tmp; \
	mv $@.tmp $@; \
	rm -f $@.input $(depfile).validate

$(modules:%.o=%.mod.rs): %.mod.rs: %.mod.h $(objtree)/scripts/mod/modpost-rust FORCE
	$(call if_changed_dep,module_metadata_data)

quiet_cmd_module_metadata_rust = $(RUSTC_OR_CLIPPY_QUIET) [M] $@
      cmd_module_metadata_rust = \
	MODULE_METADATA_DATA=$(abspath $(@:.o=.rs)) \
	$(RUSTC_OR_CLIPPY) $(rust_flags) \
		-Zallow-features=$(module-metadata-asm-feature) \
		$(if $(module-metadata-asm-feature),-Zcrate-attr='feature($(module-metadata-asm-feature))') \
		--crate-name=module_metadata -Cmetadata=$@ --crate-type=rlib \
		--extern kernel --extern pin_init --sysroot=/dev/null \
		-L $(objtree)/rust --out-dir $(dir $@) \
		--emit=dep-info=$(depfile) --emit=obj=$@ $<

$(modules:%.o=%.mod.o): %.mod.o: $(srctree)/scripts/module-metadata.rs %.mod.rs \
		$(srctree)/include/linux/export-internal_header.rs \
		$(objtree)/include/generated/rustc_cfg $(objtree)/rust/libcore.rmeta \
		$(objtree)/rust/libkernel.rmeta $(objtree)/rust/libbindings.rmeta \
		$(objtree)/rust/libpin_init.rmeta FORCE
	+$(call if_changed_dep,module_metadata_rust)

targets += $(modules:%.o=%.mod.rs)
else
%.mod.o: %.mod.c FORCE
	$(call if_changed_rule,cc_o_c)
endif

ifeq ($(CONFIG_RUST_MODULE_COMMON),y)
# Only data is emitted here. Do not run owner versioning, link C helper
# bitcode, or add a Rust module initializer to this shared metadata object.
quiet_cmd_module_common_data = MODDATA $@
      cmd_module_common_data = \
	$(CC) $(c_flags) -fsyntax-only $(srctree)/scripts/module-common.c; \
	mv $(depfile) $(depfile).validate; \
	$(CC) $(c_flags) -E -P -x c $< > $@.input; \
	cat $(depfile).validate >> $(depfile); \
	$(objtree)/scripts/module-common-data < $@.input > $@.tmp; \
	mv $@.tmp $@; \
	rm -f $@.input $(depfile).validate

.module-common-data.rs: $(srctree)/scripts/module-common-data.h \
		$(srctree)/scripts/module-common.c $(objtree)/scripts/module-common-data FORCE
	$(call if_changed_dep,module_common_data)

quiet_cmd_module_common_rust = $(RUSTC_OR_CLIPPY_QUIET) [M] $@
      cmd_module_common_rust = \
	MODULE_COMMON_DATA=$(abspath .module-common-data.rs) \
	$(RUSTC_OR_CLIPPY) $(rust_flags) -Zallow-features= \
		--crate-name=module_common --crate-type=rlib --sysroot=/dev/null \
		-L $(objtree)/rust --out-dir $(dir $@) \
		--emit=dep-info=$(depfile) --emit=obj=$@ $<

.module-common.o: $(srctree)/scripts/module-common.rs .module-common-data.rs \
		$(objtree)/include/generated/rustc_cfg $(objtree)/rust/libcore.rmeta FORCE
	+$(call if_changed_dep,module_common_rust)

targets += .module-common-data.rs
else
.module-common.o: $(srctree)/scripts/module-common.c FORCE
	$(call if_changed_rule,cc_o_c)
endif

ifneq ($(WARN_ON_UNUSED_TRACEPOINTS),)
cmd_check_tracepoint = $(objtree)/scripts/tracepoint-update --module $<;
endif

quiet_cmd_ld_ko_o = LD [M]  $@
      cmd_ld_ko_o =							\
	$(LD) -r $(KBUILD_LDFLAGS)					\
		$(KBUILD_LDFLAGS_MODULE) $(LDFLAGS_MODULE)		\
		-T $(objtree)/scripts/module.lds -o $@ $(filter %.o, $^)

quiet_cmd_btf_ko = BTF [M] $@
      cmd_btf_ko = 							\
	if [ ! -f $(objtree)/vmlinux ]; then				\
		printf "Skipping BTF generation for %s due to unavailability of vmlinux\n" $@ 1>&2; \
	else	\
		$(CONFIG_SHELL) $(srctree)/scripts/gen-btf.sh --btf_base $(objtree)/vmlinux $@; \
	fi;

# Re-generate module BTFs if either module's .ko or vmlinux changed
%.ko: %.o %.mod.o .module-common.o $(objtree)/scripts/module.lds $(and $(CONFIG_DEBUG_INFO_BTF_MODULES),$(KBUILD_BUILTIN),$(objtree)/vmlinux) FORCE
	+$(call if_changed,ld_ko_o)
ifdef CONFIG_DEBUG_INFO_BTF_MODULES
	+$(if $(newer-prereqs),$(call cmd,btf_ko))
endif
	+$(call cmd,check_tracepoint)

targets += $(modules:%.o=%.ko) $(modules:%.o=%.mod.o) .module-common.o

# Add FORCE to the prerequisites of a target to force it to be always rebuilt.
# ---------------------------------------------------------------------------

PHONY += FORCE
FORCE:

# Read all saved command lines and dependencies for the $(targets) we
# may be building above, using $(if_changed{,_dep}). As an
# optimization, we don't need to read them if the target does not
# exist, we will rebuild anyway in that case.

existing-targets := $(wildcard $(sort $(targets)))

-include $(foreach f,$(existing-targets),$(dir $(f)).$(notdir $(f)).cmd)

$(call add-config-deps)

.PHONY: $(PHONY)
