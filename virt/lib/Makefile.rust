# Keep the canonical Kbuild object and configuration interface, but select the
# repository-owned Rust implementation rather than the legacy C translation.
obj-$(CONFIG_IRQ_BYPASS_MANAGER) += irqbypass.o

# The explicit rule is required because irqbypass.c and irqbypass.rs coexist:
# the generic C %.o rule must not win through the C prerequisite.  Keep the
# canonical source filename and Kbuild's normal dependency/command tracking.
$(obj)/irqbypass.o: $(obj)/irqbypass.rs FORCE
	+$(call if_changed_rule,rustc_o_rs)
