# SPDX-License-Identifier: GPL-2.0-only
config RUST_IRQ_WORK
	bool "Rust IRQ work queueing and execution"
	depends on RUST && IRQ_WORK
	default y
	help
	  Build the IRQ work queueing and execution bodies from kernel/irq_work.rs in the
	  original kernel/irq_work.o slot, with native companions for configured
	  primitives, storage and metadata. Turning this option off selects
	  the unchanged original C provider.
