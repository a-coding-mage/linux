#define LC_WARN_ONCE(name) LUPOS_CORE_VALUE(bool, lupos_core_warn_##name, (bool condition), WARN_ON_ONCE(condition))
LC_WARN_ONCE(double_clock)
LC_WARN_ONCE(deactivate_sleep)
LC_WARN_ONCE(rtlock_state)
LC_WARN_ONCE(current_delayed)
LC_WARN_ONCE(current_blocked)
LC_WARN_ONCE(proxy_donor)
LC_WARN_ONCE(pending_on_cpu)
LC_WARN_ONCE(pending_cpu)
LC_WARN_ONCE(moved_cpu)
LC_WARN_ONCE(migration_pending)
LC_WARN_ONCE(stop_pending)
LC_WARN_ONCE(missing_pending)
LC_WARN_ONCE(owner_stop_pending)
LC_WARN_ONCE(affinity_busy)
LC_WARN_ONCE(relax_affinity)
LC_WARN_ONCE(set_cpu_blocked)
LC_WARN_ONCE(set_cpu_fair)
LC_WARN_ONCE(set_cpu_offline)
LC_WARN_ONCE(set_cpu_disabled)
LC_WARN_ONCE(core_tree)
LC_WARN_ONCE(uclamp_bucket_empty)
LC_WARN_ONCE(uclamp_bucket_value)
LC_WARN_ONCE(fork_delayed)
LC_WARN_ONCE(fork_blocked)
LC_WARN_ONCE(hrtick_cpu)
#undef LC_WARN_ONCE
