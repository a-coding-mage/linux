LUPOS_CORE_VALUE(struct task_struct *, lupos_core_next_task, (struct task_struct *p), next_task(p))
/* The two leaves below expose individual native list traversal operations;
 * the process/thread traversal, callback and lock lifetime remain in Rust. */
LUPOS_CORE_BODY(struct task_struct *, lupos_core_first_thread, (struct task_struct *g),
    __list_check_rcu(dummy, lockdep_is_held(&tasklist_lock));
    struct list_head *head = &g->signal->thread_head;
    struct list_head *node = READ_ONCE(head->next);
    return node == head ? NULL : list_entry(node, struct task_struct, thread_node);)
LUPOS_CORE_BODY(struct task_struct *, lupos_core_next_thread_in_group, (struct task_struct *g, struct task_struct *p),
    struct list_head *node = READ_ONCE(p->thread_node.next);
    return node == &g->signal->thread_head ? NULL : list_entry(node, struct task_struct, thread_node);)
