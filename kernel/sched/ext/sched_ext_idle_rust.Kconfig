# SPDX-License-Identifier: GPL-2.0
config RUST_SCHED_EXT_IDLE
	bool "Rust sched_ext idle source owner proposal"
	depends on RUST && SCHED_CLASS_EXT && BROKEN
	default n
	help
	  Inactive continuation of built-in idle tracking and CPU selection.
	  Native ABI/CFI, BTF shared-unit/context, allocation/locking and
	  compiler protection/runtime qualification remain outstanding.
