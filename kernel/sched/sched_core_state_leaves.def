LUPOS_CORE_VALUE(const struct sched_class *, lupos_core_first_class, (void), __sched_class_highest)
LUPOS_CORE_BODY(const struct sched_class *, lupos_core_next_class, (const struct sched_class *class),
	++class; return class < __sched_class_lowest ? class : NULL;)
LUPOS_CORE_VALUE(const struct sched_class *, lupos_core_first_active_class, (void), __sched_class_highest)
LUPOS_CORE_VALUE(const struct sched_class *, lupos_core_first_active_class_from, (const struct sched_class *class), class)
LUPOS_CORE_BODY(const struct sched_class *, lupos_core_next_active_class, (const struct sched_class *class),
	class = next_active_class(class); return class != __sched_class_lowest ? class : NULL;)
/* Exact two clauses of for_each_set_bit_wrap from include/linux/find.h.
 * Unlike cpumask_next_wrap, the second clause terminates after one traversal. */
LUPOS_CORE_VALUE(int, lupos_core_cpu_next_wrap, (int cpu, const struct cpumask *mask, int start),
	cpu == -1 ? find_next_bit_wrap(cpumask_bits(mask), small_cpumask_bits, start) :
	__for_each_wrap(cpumask_bits(mask), small_cpumask_bits, start, cpu + 1))
