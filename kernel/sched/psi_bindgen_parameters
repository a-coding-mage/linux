# Source input only. Configured declarations and callback CFI are unqualified.
--no-doc-comments
--no-default '.*'
--no-prepend-enum-name
--allowlist-type 'psi_.*|rq|rq_flags|task_struct|cgroup|css_set|kernfs_open_file|seq_file|file|inode|poll_table|poll_table_struct|timer_list|work_struct|delayed_work|__poll_t|ssize_t|loff_t'
--allowlist-function 'rust_psi_.*'
--allowlist-var 'RUST_PSI_.*|rust_psi_.*|psi_system'
--opaque-type 'xregs_state|desc_struct|arch_lbr_state|local_apic|alt_instr|x86_msi_data|x86_msi_addr_lo|lowcore|tod_clock|tpi_info|uv_cb.*|uv_secret.*|zpci_fib'
--with-attribute-custom-struct=psi_group='#[cfi_encoding="9psi_group"]'
--with-attribute-custom-struct=psi_trigger='#[cfi_encoding="11psi_trigger"]'
--with-attribute-custom-struct=task_struct='#[cfi_encoding="11task_struct"]'
--with-attribute-custom-struct=seq_file='#[cfi_encoding="8seq_file"]'
--with-attribute-custom-struct=file='#[cfi_encoding="4file"]'
--with-attribute-custom-struct=inode='#[cfi_encoding="5inode"]'
--with-attribute-custom-struct=poll_table_struct='#[cfi_encoding="17poll_table_struct"]'
--with-attribute-custom-struct=work_struct='#[cfi_encoding="11work_struct"]'
--with-attribute-custom-struct=timer_list='#[cfi_encoding="10timer_list"]'
