/* include/linux/debug_locks.h macro expansion; preserve the original expression text. */
LUPOS_CORE_BODY(bool, lupos_core_debug_locks_warn_on_site_5990, (bool condition),
	int ret = 0;
	if (!oops_in_progress && unlikely(condition)) {
		instrumentation_begin();
		if (debug_locks_off() && !debug_locks_silent)
			WARN(1, "DEBUG_LOCKS_WARN_ON(%s)", "(preempt_count() < 0)");
		instrumentation_end();
		ret = 1;
	}
	return ret;)
/* include/linux/debug_locks.h macro expansion; preserve the original expression text. */
LUPOS_CORE_BODY(bool, lupos_core_debug_locks_warn_on_site_5999, (bool condition),
	int ret = 0;
	if (!oops_in_progress && unlikely(condition)) {
		instrumentation_begin();
		if (debug_locks_off() && !debug_locks_silent)
			WARN(1, "DEBUG_LOCKS_WARN_ON(%s)", "(preempt_count() & PREEMPT_MASK) >= PREEMPT_MASK - 10");
		instrumentation_end();
		ret = 1;
	}
	return ret;)
/* include/linux/debug_locks.h macro expansion; preserve the original expression text. */
LUPOS_CORE_BODY(bool, lupos_core_debug_locks_warn_on_site_6026, (bool condition),
	int ret = 0;
	if (!oops_in_progress && unlikely(condition)) {
		instrumentation_begin();
		if (debug_locks_off() && !debug_locks_silent)
			WARN(1, "DEBUG_LOCKS_WARN_ON(%s)", "pc - uval > pc");
		instrumentation_end();
		ret = 1;
	}
	return ret;)
/* include/linux/debug_locks.h macro expansion; preserve the original expression text. */
LUPOS_CORE_BODY(bool, lupos_core_debug_locks_warn_on_site_6033, (bool condition),
	int ret = 0;
	if (!oops_in_progress && unlikely(condition)) {
		instrumentation_begin();
		if (debug_locks_off() && !debug_locks_silent)
			WARN(1, "DEBUG_LOCKS_WARN_ON(%s)", "(val < PREEMPT_MASK) && !(preempt_count() & PREEMPT_MASK)");
		instrumentation_end();
		ret = 1;
	}
	return ret;)
