/* One macro expansion per Rust diagnostic site. No shared once-state or
 * runtime-ID dispatcher. Numeric suffixes are stable source mapping IDs,
 * not a claim of identical emitted/native source coordinates. */
LUPOS_CORE_VOID(lupos_core_bug_on_site_5951, (bool condition), BUG_ON(condition))
