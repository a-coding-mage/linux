#ifdef CONFIG_DEBUG_ATOMIC_SLEEP
LUPOS_CORE_VOID(lupos_core_warn_invalid_sleep_state, (bool condition, unsigned int state, unsigned long ip),
	WARN_ONCE(condition, "do not call blocking ops when !TASK_RUNNING; "
		"state=%x set at [<%p>] %pS\n", state, (void *)ip, (void *)ip))
#endif

/* BUG can be a NOP in the original generic header; preserve its caller's
 * continuation, especially do_task_dead's explicit cpu_relax loop. */
