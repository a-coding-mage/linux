/* Header and external primitives only. Deadline lifecycle decisions stay Rust. */
DL_LEAF(void, lifecycle_rq_unpin_lock, (struct rq *rq, struct rq_flags *rf), { rq_unpin_lock(rq, rf); })
DL_LEAF(void, lifecycle_rq_repin_lock, (struct rq *rq, struct rq_flags *rf), { rq_repin_lock(rq, rf); })
DL_LEAF(void, lifecycle_rq_lock, (struct rq *rq, struct rq_flags *rf), { rq_lock(rq, rf); })
DL_LEAF(void, lifecycle_rq_unlock, (struct rq *rq, struct rq_flags *rf), { rq_unlock(rq, rf); })
DL_LEAF(void, lifecycle_rq_lock_irq, (struct rq *rq, struct rq_flags *rf), { rq_lock_irq(rq, rf); })
DL_LEAF(void, lifecycle_rq_unlock_irq, (struct rq *rq, struct rq_flags *rf), { rq_unlock_irq(rq, rf); })
DL_LEAF(void, lifecycle_lockdep_unpin_rq, (struct rq *rq, struct rq_flags *rf), { lockdep_unpin_lock(__rq_lockp(rq), rf->cookie); })
DL_LEAF(void, lifecycle_lockdep_pin_rq, (struct rq *rq, struct rq_flags *rf), { rf->cookie = lockdep_pin_lock(__rq_lockp(rq)); })
DL_LEAF(struct rq *, lifecycle_task_rq_lock, (struct task_struct *p, struct rq_flags *rf), { return task_rq_lock(p, rf); })
DL_LEAF(void, lifecycle_task_rq_unlock, (struct rq *rq, struct task_struct *p, struct rq_flags *rf), { task_rq_unlock(rq, p, rf); })
DL_LEAF(void, lifecycle_sched_clock_tick, (void), { sched_clock_tick(); })
DL_LEAF(void, lifecycle_update_rq_clock, (struct rq *rq), { update_rq_clock(rq); })
DL_LEAF(u64, lifecycle_hrtimer_forward_now, (struct hrtimer *timer, ktime_t interval), { return hrtimer_forward_now(timer, interval); })
DL_LEAF(bool, lifecycle_entity_preempt, (const struct sched_dl_entity *a, const struct sched_dl_entity *b), { return dl_entity_preempt(a, b); })
DL_LEAF(void, lifecycle_resched_curr, (struct rq *rq), { resched_curr(rq); })
DL_LEAF(struct sched_dl_entity *, lifecycle_entity_from_dl_timer, (struct hrtimer *timer), { return container_of(timer, struct sched_dl_entity, dl_timer); })
DL_LEAF(struct sched_dl_entity *, lifecycle_entity_from_inactive_timer, (struct hrtimer *timer), { return container_of(timer, struct sched_dl_entity, inactive_timer); })
DL_LEAF(void, lifecycle_hrtimer_setup, (struct hrtimer *timer, enum hrtimer_restart (*fn)(struct hrtimer *), clockid_t clock, enum hrtimer_mode mode), { hrtimer_setup(timer, fn, clock, mode); })
DL_LEAF(bool, lifecycle_idle_rq, (struct rq *rq), { return idle_rq(rq); })
DL_LEAF(void, lifecycle_trace_update, (struct sched_dl_entity *s, int cpu, u8 type), { trace_sched_dl_update_tp(s, cpu, type); })
#ifdef CONFIG_RT_GROUP_SCHED
DL_LEAF(int, lifecycle_rt_bandwidth_enabled, (void), { return rt_bandwidth_enabled(); })
DL_LEAF(bool, lifecycle_sched_rt_bandwidth_account, (struct rt_rq *rq), { return sched_rt_bandwidth_account(rq); })
#endif
DL_LEAF(bool, lifecycle_cpu_online, (int cpu), { return cpu_online(cpu); })
DL_LEAF(bool, lifecycle_server_active, (struct sched_dl_entity *s), { return dl_server_active(s); })
DL_LEAF(void, lifecycle_trace_server_start, (struct sched_dl_entity *s, int cpu, u8 type), { trace_sched_dl_server_start_tp(s, cpu, type); })
DL_LEAF(void, lifecycle_trace_server_stop, (struct sched_dl_entity *s, int cpu, u8 type), { trace_sched_dl_server_stop_tp(s, cpu, type); })
DL_LEAF(s64, lifecycle_update_curr_common, (struct rq *rq), { return update_curr_common(rq); })
DL_LEAF(void, lifecycle_raw_spin_lock_irq, (raw_spinlock_t *lock), { raw_spin_lock_irq(lock); })
DL_LEAF(void, lifecycle_raw_spin_unlock_irq, (raw_spinlock_t *lock), { raw_spin_unlock_irq(lock); })
DL_LEAF(int, lifecycle_task_current, (struct rq *rq, struct task_struct *p), { return task_current(rq, p); })
DL_LEAF(u64, lifecycle_ktime_get_ns, (void), { return ktime_get_ns(); })
DL_LEAF(void, lifecycle_rb_clear_node, (struct rb_node *node), { RB_CLEAR_NODE(node); })
DL_LEAF(void, lifecycle_print_dl_rq, (struct seq_file *m, int cpu, struct dl_rq *rq), { print_dl_rq(m, cpu, rq); })
DL_LEAF(struct task_struct *, lifecycle_rq_curr, (struct rq *rq), { return rq->curr; })
DL_LEAF(struct task_struct *, lifecycle_rq_donor, (struct rq *rq), { return rq->donor; })
/* Original branch-hint sites; native profiling/codegen still needs qualification. */
DL_LEAF(bool, lifecycle_unlikely_timer_offline, (bool condition), { return unlikely(condition); })
DL_LEAF(bool, lifecycle_unlikely_delta_nonpositive, (bool condition), { return unlikely(condition); })
DL_LEAF(bool, lifecycle_unlikely_delta_yielded, (bool condition), { return unlikely(condition); })
DL_LEAF(bool, lifecycle_unlikely_throttle_timer, (bool condition), { return unlikely(condition); })
