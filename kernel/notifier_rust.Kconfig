config RUST_NOTIFIER
	bool "Rust notifier source proposal (not admitted)"
	depends on RUST && BROKEN
	default n
	help
	  Inactive continuation of notifier traversal and synchronization.
	  Native ABI/CFI, context analysis, notrace/NOKPROBE coverage,
	  profiling attribution and original tests remain unqualified.
