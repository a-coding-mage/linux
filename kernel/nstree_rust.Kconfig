config RUST_NSTREE
	bool "Rust namespace-tree source proposal (not admitted)"
	depends on RUST && BROKEN
	default n
	help
	  Inactive continuation of namespace-tree algorithms and listing.
	  Native ABI/CFI, protection, usercopy and original tests remain
	  unqualified. Keep this disabled.
