config RUST_USER_ACCOUNTING
	bool "Rust user-cache source proposal (not admitted)"
	depends on RUST && BROKEN
	default n
	help
	  Inactive continuation of the existing user-cache Rust owner.
	  Native ABI/CFI, configured storage, reference and IRQ semantics,
	  init metadata and original tests remain unqualified.
