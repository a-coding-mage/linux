# SPDX-License-Identifier: GPL-2.0-only
config RUST_USER_ACCOUNTING
	bool "Rust per-user accounting cache"
	depends on RUST
	default y
	help
	  Build the per-user accounting cache bodies from kernel/user.rs in the
	  original kernel/user.o slot, with native companions for configured
	  primitives, storage and metadata. Turning this option off selects
	  the unchanged original C provider.
