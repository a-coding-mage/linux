# SPDX-License-Identifier: GPL-2.0-only
config RUST_NSPROXY
	bool "Rust namespace proxy creation, setns and unshare"
	depends on RUST
	default y
	help
	  Build the namespace proxy creation, setns and unshare bodies from kernel/nsproxy.rs in the
	  original kernel/nsproxy.o slot, with native companions for configured
	  primitives, storage and metadata. Turning this option off selects
	  the unchanged original C provider.
