# SPDX-License-Identifier: GPL-2.0-or-later
config RUST_STOP_MACHINE
	bool "Rust CPU stopper and stop_machine"
	depends on RUST && SMP
	default y
	help
	  Build the CPU stopper and stop_machine bodies from kernel/stop_machine.rs in the
	  original kernel/stop_machine.o slot, with native companions for configured
	  primitives, storage and metadata. Turning this option off selects
	  the unchanged original C provider.
