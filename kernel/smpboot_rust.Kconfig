# SPDX-License-Identifier: GPL-2.0-only
config RUST_SMPBOOT
	bool "Rust per-CPU hotplug thread management"
	depends on RUST
	default y
	help
	  Build the per-CPU hotplug thread management bodies from kernel/smpboot.rs in the
	  original kernel/smpboot.o slot, with native companions for configured
	  primitives, storage and metadata. Turning this option off selects
	  the unchanged original C provider.
