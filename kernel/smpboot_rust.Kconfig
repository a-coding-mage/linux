config RUST_SMPBOOT
	bool "Rust smpboot lifecycle source proposal (not admitted)"
	depends on RUST && BROKEN
	default n
	help
	  Inactive continuation of thread and idle-cache lifecycle bodies.
	  Native callbacks, storage, ABI/CFI, init attributes and original
	  tests remain unqualified. Keep this disabled.
