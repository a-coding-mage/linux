# SPDX-License-Identifier: GPL-2.0-only
config RUST_FREEZER
	bool "Rust freezer source proposal (not admitted)"
	depends on RUST && FREEZER && BROKEN
	default n
	help
	  Inactive continuation of the existing task-freezer Rust owner.
	  Native static-key/lock initialization, IRQ/state protocols,
	  ABI/CFI, diagnostic attribution and original tests remain
	  unqualified. Keep this disabled.
