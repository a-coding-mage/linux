# SPDX-License-Identifier: GPL-2.0-only
config RUST_UMH
	bool "Rust usermode-helper execution and policy"
	depends on RUST
	default y
	help
	  Build the usermode-helper execution and policy bodies from kernel/umh.rs in the
	  original kernel/umh.o slot, with native companions for configured
	  primitives, storage and metadata. Turning this option off selects
	  the unchanged original C provider.
