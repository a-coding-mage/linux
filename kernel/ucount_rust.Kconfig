# SPDX-License-Identifier: GPL-2.0-only
config RUST_UCOUNT
	bool "Rust user/resource accounting source proposal (not admitted)"
	depends on RUST && BROKEN
	default n
	help
	  Inactive continuation of the existing user-accounting Rust owner.
	  Configured ABI/CFI, native atomic/reference semantics, metadata and
	  original-test qualification remain open. Keep this disabled.
