# SPDX-License-Identifier: GPL-2.0
config RUST_GROUPS
	bool "Rust supplementary group lists and syscalls"
	depends on RUST && MULTIUSER
	default y
	help
	  Build the supplementary group lists and syscalls bodies from kernel/groups.rs in the
	  original kernel/groups.o slot, with native companions for configured
	  primitives, storage and metadata. Turning this option off selects
	  the unchanged original C provider.
