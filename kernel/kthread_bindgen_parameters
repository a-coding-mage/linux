--no-doc-comments
--no-default '.*'
--no-prepend-enum-name
# The work callback is invoked by Rust; give its pointed-to native record the
# C type spelling required by CFI. ABI wrappers handle the other callbacks.
--with-attribute-custom-struct=kthread_work='#[cfi_encoding="12kthread_work"]'
--with-attribute-custom-struct=task_struct='#[cfi_encoding="11task_struct"]'
--with-attribute-custom-struct=kthread='#[cfi_encoding="7kthread"]'
--with-attribute-custom-struct=completion='#[cfi_encoding="10completion"]'
--with-attribute-custom-struct=cpumask='#[cfi_encoding="7cpumask"]'
--with-attribute-custom-struct=kthread_worker='#[cfi_encoding="14kthread_worker"]'
--with-attribute-custom-struct=kthread_delayed_work='#[cfi_encoding="20kthread_delayed_work"]'
--with-attribute-custom-struct=timer_list='#[cfi_encoding="10timer_list"]'
--with-attribute-custom-struct=mm_struct='#[cfi_encoding="9mm_struct"]'
--with-attribute-custom-struct=cgroup_subsys_state='#[cfi_encoding="19cgroup_subsys_state"]'
--with-attribute-custom-struct=lock_class_key='#[cfi_encoding="14lock_class_key"]'
--opaque-type 'xregs_state|desc_struct|arch_lbr_state|local_apic|alt_instr|x86_msi_data|x86_msi_addr_lo|lowcore|tod_clock|tpi_info|uv_cb.*|uv_secret.*|zpci_fib|mm_struct|cgroup_subsys_state'
--allowlist-type 'task_struct|completion|list_head|cpumask|raw_spinlock_t|lock_class_key|sched_param|kthread_create_info|kthread|kthread_worker|kthread_work|kthread_delayed_work|timer_list|lupos_kthread_cpumask|lupos_kthread_flush_work'
--allowlist-function 'lupos_kthread_.*|kfree|complete|wait_for_completion|wait_for_completion_killable|copy_from_kernel_nofault|do_exit|sched_setscheduler_nocheck|schedule_preempt_disabled|schedule|kernel_thread|wait_task_inactive|set_cpus_allowed_force|set_cpus_allowed_ptr|wake_up_state|wake_up_process|add_timer|timer_delete_sync|kthread_create_on_node|kthread_create_worker_on_node'
--allowlist-var 'LUPOS_KTHREAD_.*|KTHREAD_IS_PER_CPU|KTHREAD_SHOULD_STOP|KTHREAD_SHOULD_PARK|MAX_ERRNO|NUMA_NO_NODE|PF_KTHREAD|PF_NO_SETAFFINITY|PF_EXITING|PF_NOFREEZE|TASK_RUNNING|TASK_UNINTERRUPTIBLE|TASK_INTERRUPTIBLE|TASK_PARKED|KTW_FREEZABLE|SCHED_NORMAL|CLONE_FS|CLONE_FILES|SIGCHLD|EINTR|ENOMEM|EINVAL|ENOSYS|EBUSY'
