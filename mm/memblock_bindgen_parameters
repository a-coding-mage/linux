--allowlist-function '^(__next_mem_range|__next_mem_range_rev)$'
--with-attribute-custom-struct=memblock_type='#[cfi_encoding="13memblock_type"]'
--with-attribute-custom-struct=memblock_region='#[cfi_encoding="15memblock_region"]'
--with-attribute-custom-struct=memblock='#[cfi_encoding="8memblock"]'
--with-attribute-custom-struct=pglist_data='#[cfi_encoding="11pglist_data"]'
--with-attribute-custom-struct=zone='#[cfi_encoding="4zone"]'
--with-attribute-custom-struct=seq_file='#[cfi_encoding="8seq_file"]'
