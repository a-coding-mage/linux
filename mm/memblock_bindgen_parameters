--no-doc-comments
--no-prepend-enum-name
--allowlist-type '^(memblock|memblock_type|memblock_region|memblock_flags|pglist_data|zone|seq_file)$'
--allowlist-function '^(rust_memblock_.*|_printk|panic|kfree|snprintf|strlen|strcmp|strstr|memparse|memblock_free_pages|init_deferred_page|first_online_pgdat|next_online_pgdat|kho_is_enabled|kho_preserve_pages|kho_unpreserve_pages|kho_add_subtree|kho_remove_subtree|kho_retrieve_subtree|fdt_create|fdt_finish_reservemap|fdt_begin_node|fdt_property|fdt_end_node|fdt_finish|fdt_node_check_compatible|fdt_subnode_offset|fdt_getprop|seq_printf|string_get_size|debugfs_create_dir)$'
--allowlist-function '^(memblock_add_node|memblock_add|memblock_remove|memblock_phys_free|__memblock_reserve|memblock_physmem_add|memblock_phys_alloc_range|memblock_alloc_exact_nid_raw|memblock_alloc_try_nid_raw|memblock_alloc_hugetlb|memblock_alloc_try_nid)$'
